<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Override page title and favicon -->
    <template id="markition_web_layout" inherit_id="web.layout" name="Markition Web Layout">
        <xpath expr="//title" position="replace">
            <title t-esc="title or 'ERP Markition'"/>
        </xpath>
        <xpath expr="//link[@rel='shortcut icon']" position="replace">
            <link type="image/svg+xml" rel="shortcut icon" href="/markition_branding/static/img/fav-icon-white.svg"/>
        </xpath>
    </template>

    <!-- Hide "Powered by Odoo" promotion block site-wide (defined in web, always present) -->
    <template id="brand_promotion_debrand" inherit_id="web.brand_promotion">
        <xpath expr="//div[hasclass('o_brand_promotion')]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>

    <!-- Login page logo and Powered-by branding are handled entirely via CSS (login.css).
         XPath overrides on web.login_layout are not used here because the website module
         (priority 20) replaces the inner structure of web.login_layout before our template
         runs, making the original divs unreachable by XPath. CSS is applied after render
         and works regardless of which modules have modified the template. -->

</odoo>
