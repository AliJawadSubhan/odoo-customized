<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Patch l10n_sa.l10n_sa_report_invoice_document to render the ZATCA QR code.

        The l10n_sa module may be installed from an older snapshot that predates the
        QR rendering block, so ir_ui_view has no entry referencing l10n_sa_qr_code_str.
        This view adds the block explicitly.

        Insertion point: after div#qrcode (the bank-payment QR block from the base
        account.report_invoice_document template, baked into the SA primary template).
        div#qrcode lives inside a t-else, so this sibling div renders unconditionally
        and its own t-if controls visibility — mirroring what l10n_sa would do when
        its view is current.
    -->
    <template id="markition_zatca_qr_on_invoice"
              name="Markition: ZATCA QR on Saudi Invoice"
              inherit_id="l10n_sa.l10n_sa_report_invoice_document">

        <xpath expr="//div[@id='qrcode']" position="after">
            <div t-if="o.l10n_sa_qr_code_str"
                 id="markition_zatca_qr_code"
                 class="d-flex mt-2 avoid-page-break-inside">
                <p class="mb-0 me-3">
                    <img class="d-block"
                         t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('QR', quote_plus(o.l10n_sa_qr_code_str), 200, 200)"/>
                </p>
            </div>
        </xpath>

    </template>
</odoo>
