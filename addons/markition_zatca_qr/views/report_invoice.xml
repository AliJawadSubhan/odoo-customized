<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Patches l10n_sa.l10n_sa_report_invoice_document (primary template compiled into DB).

        Root cause: the production DB was loaded from an older snapshot of l10n_sa where the
        QR img tag used `o.l10n_sa_is_legal` (plain field access, no underscore, no parens).
        That attribute does not exist on account.move — QWeb treats the missing reference as
        False, so the QR block never renders even when l10n_sa_qr_code_str is populated.

        The current on-disk source uses `o._l10n_sa_is_legal()` (underscore method call), but
        the DB stores the compiled arch from the older version. We cannot change the DB's
        stored arch directly without touching the core module, so we override it here via
        inheritance: replace only the t-if attribute on the img so it gates directly on the
        QR field, which is what _l10n_sa_is_legal() checks anyway.
    -->
    <template id="markition_zatca_qr_on_invoice"
              name="Markition: Fix ZATCA QR t-if on Saudi Invoice"
              inherit_id="l10n_sa.l10n_sa_report_invoice_document">

        <xpath expr="//div[@id='l10n_sa_qr_code']//img" position="attributes">
            <attribute name="t-if">o.l10n_sa_qr_code_str</attribute>
        </xpath>

    </template>
</odoo>
